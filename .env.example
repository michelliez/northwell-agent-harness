ANTHROPIC_API_KEY=
# Optional fallback used by config if ANTHROPIC_API_KEY is empty.
AI_HUB_API_KEY=
ANTHROPIC_BASE_URL=https://ai-hub-api-v2-dev-970320824155.us-east4.run.app/anthropic-gateway
ANTHROPIC_CUSTOM_HEADERS=x-client-id: <your-client-id>

CLAUDE_MODEL=claude-sonnet-4-6

RAG_DB_PATH=var/rag/index.sqlite
MCP_SERVER_URL=http://localhost:8000/mcp
INTENT_MCP_URL=http://localhost:8002/mcp
SQL_GENERATION_MCP_URL=http://localhost:8003/mcp
SQL_VALIDATION_MCP_URL=http://localhost:8004/mcp
RAG_MCP_URL=http://localhost:8005/mcp
MCP_AUTH_TOKEN=replace-with-a-local-service-token
# Start required local MCP servers as CLI-owned subprocesses.
MCP_AUTO_START=true
MCP_STARTUP_TIMEOUT_SECONDS=10
MCP_LOG_DIR=logs/mcp
MAX_TOOL_ROUNDS=3
MAX_MODEL_CALLS=4
MAX_TOOL_CALLS=12
MAX_CALLS_PER_TOOL=6
MAX_CANDIDATE_SCHEMAS=5
MAX_INPUT_BYTES=16000
MAX_TOOL_RESULT_BYTES=32000
MAX_CONTEXT_BYTES=128000
MAX_WALL_SECONDS=60
MCP_CALL_TIMEOUT_SECONDS=10
MODEL_CALL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=800
INTENT_MAX_TOKENS=200
SQL_GENERATION_MAX_TOKENS=500
INTENT_MIN_CONFIDENCE=0.70
TRACE_DIR=logs/runs
LOG_RAW_PROMPTS=false
TRACE_CONTENT_MODE=metadata
# Optional keyed HMAC secret used to correlate redacted trace content.
TRACE_HASH_KEY=
