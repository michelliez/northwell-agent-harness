ANTHROPIC_API_KEY=
# Optional fallback used by config if ANTHROPIC_API_KEY is empty.
AI_HUB_API_KEY=
ANTHROPIC_BASE_URL=https://ai-hub-api-v2-dev-970320824155.us-east4.run.app/anthropic-gateway
ANTHROPIC_CUSTOM_HEADERS=x-client-id: <your-client-id>

CLAUDE_MODEL=claude-sonnet-4-6

# RAG index location. Built indexes live in the shared fixtures/ directory
# beside both repo checkouts (nothing under fixtures/ is committed). Point this
# at the current winning index; forward slashes work on Windows and avoid
# backslash-escaping issues. Falls back to .local/rag/index.sqlite when unset.
RAG_DB_PATH=../fixtures/rag/index-v6-genq-combined-expansion.sqlite

# Base path for generated runtime artifacts, traces, evaluations, and GenQ data.
# GenQ conventions:
#   .local/genq/corpus
#   .local/queries/{t5,claude,reviewed}
#   .local/embeddings
ARTIFACT_PATH=.local

INTENT_MIN_CONFIDENCE=0.70
TRACE_CONTENT_MODE=metadata
# Optional keyed HMAC secret used to correlate redacted trace content.
TRACE_HASH_KEY=

GOOGLE_CLOUD_PROJECT=<your-project>
# BigQuery cost authorization (required only when dry-run/execution is enabled).
# Example: 10 GiB. Choose a ceiling appropriate for your environment.
BIGQUERY_MAX_BYTES_PROCESSED=10737418240
# Generate a secret with: openssl rand -hex 32
BIGQUERY_APPROVAL_HMAC_SECRET=
BIGQUERY_APPROVAL_TOKEN_TTL_SECONDS=300
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=

ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
