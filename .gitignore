data/ClarityDictionaryHTML-full*

# Generated retrieval indexes and HTML-derived ML artifacts — never commit
var/rag/*.sqlite
rag/*.sqlite
/var/genq/
/data/genq/
/artifacts/genq/
*.sqlite

