diff --git a/cmake/omp_stub/omp.h b/cmake/omp_stub/omp.h
new file mode 100644
index 0000000..c74bf4f
--- /dev/null
+++ b/cmake/omp_stub/omp.h
@@ -0,0 +1,47 @@
+#pragma once
+
+// Serial OpenMP compatibility layer for builds compiled without OpenMP.
+// OpenMP pragmas are ignored by the compiler, so only the small runtime API
+// surface used by FAISS needs single-threaded definitions.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef int omp_lock_t;
+
+static inline int omp_get_max_threads(void) {
+    return 1;
+}
+
+static inline int omp_get_num_threads(void) {
+    return 1;
+}
+
+static inline int omp_get_thread_num(void) {
+    return 0;
+}
+
+static inline int omp_in_parallel(void) {
+    return 0;
+}
+
+static inline int omp_get_nested(void) {
+    return 0;
+}
+
+static inline void omp_set_num_threads(int) {}
+static inline void omp_set_nested(int) {}
+static inline void omp_init_lock(omp_lock_t* lock) {
+    *lock = 0;
+}
+static inline void omp_destroy_lock(omp_lock_t*) {}
+static inline void omp_set_lock(omp_lock_t*) {}
+static inline void omp_unset_lock(omp_lock_t*) {}
+static inline int omp_test_lock(omp_lock_t*) {
+    return 1;
+}
+
+#ifdef __cplusplus
+}
+#endif
